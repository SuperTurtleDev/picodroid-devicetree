From 8962f22efdca32136712d062a6d7d2a04253de05 Mon Sep 17 00:00:00 2001
From: picodroid-builder <builder@picodroid.local>
Date: Wed, 30 Sep 2026 19:40:24 +0000
Subject: [PATCH] picodroid: GSI vndk-nodef rc warns instead of rebooting

BOARD_VNDK_VERSION := current (picodroid/Cuttlefish) leaves ro.vndk.version
unset, so the stock GSI nodef rc would reboot to bootloader on every boot.
Log a kmsg warning and continue.

Change-Id: I2092c3c3d5579bbe75f5f5b256585b84f53e5d04
---
 target/product/gsi/init.vndk-nodef.rc | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/target/product/gsi/init.vndk-nodef.rc b/target/product/gsi/init.vndk-nodef.rc
index 1b141a0..291e22b 100644
--- a/target/product/gsi/init.vndk-nodef.rc
+++ b/target/product/gsi/init.vndk-nodef.rc
@@ -1,3 +1,5 @@
 on early-init
-    # Reboot if BOARD_VNDK_VERSION is not defined
-    exec - root -- /system/bin/reboot bootloader
+    # picodroid: upstream reboots to bootloader when BOARD_VNDK_VERSION is undefined
+    # (ro.vndk.version unset). picodroid builds with BOARD_VNDK_VERSION := current
+    # (e.g. Cuttlefish), so warn and continue instead of rebooting.
+    write /dev/kmsg "picodroid: ro.vndk.version undefined (current vendor); official GSI would reboot to bootloader - continuing"
-- 
2.43.0

