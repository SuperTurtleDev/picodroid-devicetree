From b376db1b9af5272c24a006eaa39eb0e17f35de48 Mon Sep 17 00:00:00 2001
From: picodroid-builder <builder@picodroid.local>
Date: Thu, 1 Oct 2026 07:08:23 +0000
Subject: [PATCH] picodroid: adbd defaults to root + no auth (headless)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

should_drop_privileges() returns false (ro.secure from real-device vendor
build.prop would drop adbd to shell); auth_required hard false (no UI to
accept the RSA dialog; vendor injects ro.adb.secure=1 → permanently
'unauthorized').

Change-Id: I8a6dd79bb9e2cb3fd5f47e82611c86290296470d
---
 daemon/main.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/daemon/main.cpp b/daemon/main.cpp
index 3d3f302..983d7ca 100644
--- a/daemon/main.cpp
+++ b/daemon/main.cpp
@@ -64,6 +64,10 @@ static const char* root_seclabel = nullptr;
 static const char* tim_seclabel = nullptr;
 
 static bool should_drop_privileges() {
+    // picodroid: headless debug GSI（补丁 0018）——adbd 默认以 root 运行。
+    // stock 语义依赖 ro.secure/ro.debuggable（真机 vendor build.prop 会注入
+    // ro.secure=1 令 adbd 降权到 shell）；无头形态无 UI 放权面，恒为 root。
+    return false;
     // The properties that affect `adb root` and `adb unroot` are ro.secure and
     // ro.debuggable. In this context the names don't make the expected behavior
     // particularly obvious.
@@ -230,7 +234,9 @@ int adbd_main() {
         // need for manual intervention(b/188703874).
 #else
         // If we're on userdebug/eng or the device is unlocked, permit no-authentication.
-        auth_required = android::base::GetBoolProperty("ro.adb.secure", false);
+        // picodroid（补丁 0018）：无头系统没有授权弹窗 UI——恒免认证。
+        // stock 读 ro.adb.secure（真机 vendor build.prop 注入 1 → 恒 unauthorized）。
+        auth_required = false;
 #endif
     }
 #endif
-- 
2.43.0

