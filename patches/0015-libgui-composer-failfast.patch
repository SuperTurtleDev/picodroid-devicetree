+// only reference that pulled the generated AIDL interface implementations
+// (Bn/Bp ISurfaceComposer, IRegionSamplingListener, IFpsListener, the
+// parcelables, ...) out of libgui_aidl_static into libgui.so, which broke
+// components that link against them (libandroid_runtime subclasses
+// BnRegionSamplingListener). asInterface(nullptr) is a pure local null
+// conversion — zero servicemanager lookups, zero binder traffic — it only
+// keeps those interface definitions present in libgui.so.
+sp<gui::ISurfaceComposer> picodroid_keepSurfaceComposerAidlAbi() {
+    return gui::ISurfaceComposer::asInterface(nullptr);
